/* ------------------------------------------------------------------ */
/* Preparação da planilha                                              */
/* ------------------------------------------------------------------ */
function configurar() {
  const p = aba_('Produtos', COLS_PROD);
  const t = aba_('Portfolio', COLS_PORT);
  const tb = aba_('Itens da tabua', COLS_TAB);
  aba_('Clientes', COLS_CLI);
  aba_('Pedidos', COLS_PED);
  if (p.getLastRow() < 2) p.getRange(2, 1, SEED_PROD.length, COLS_PROD.length).setValues(SEED_PROD);
  if (t.getLastRow() < 2) t.getRange(2, 1, SEED_PORT.length, COLS_PORT.length).setValues(SEED_PORT);
  if (tb.getLastRow() < 2) tb.getRange(2, 1, SEED_TAB.length, COLS_TAB.length).setValues(SEED_TAB);
  const regra = SpreadsheetApp.newDataValidation().requireValueInList(['Tem', 'Em falta', 'Oculto'], true).build();
  p.getRange(2, 2, p.getMaxRows() - 1, 1).setDataValidation(regra);
  t.getRange(2, 2, t.getMaxRows() - 1, 1).setDataValidation(regra);
  const regraTab = SpreadsheetApp.newDataValidation().requireValueInList(['Ativo', 'Oculto'], true).build();
  tb.getRange(2, 2, tb.getMaxRows() - 1, 1).setDataValidation(regraTab);
  cacheDel_();
  return 'ok';
}

function aba_(nome, cols) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(nome) || ss.insertSheet(nome);
  if (sh.getLastRow() === 0) {
    sh.appendRow(cols);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, cols.length).setFontWeight('bold');
  }
  return sh;
}

/* ------------------------------------------------------------------ */
/* Leitura                                                             */
/* ------------------------------------------------------------------ */
function semAcento_(s) {
  return String(s == null ? '' : s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
}
function status_(s) {
  const v = semAcento_(s);
  if (v.indexOf('falta') >= 0) return 'falta';
  if (v.indexOf('ocult') >= 0 || v === 'nao' || v === 'inativo') return 'oculto';
  return 'disponivel';
}
function num_(v) {
  if (typeof v === 'number') return v;
  let s = String(v == null ? '' : v).replace(/[^\d,.-]/g, '');
  if (!s) return 0;
  if (s.indexOf(',') >= 0) s = s.replace(/\./g, '').replace(',', '.');
  const n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}
function novoId_() {
  return 'p' + Date.now().toString(36) + Math.floor(Math.random() * 1296).toString(36);
}

function tabela_(nome, cols) {
  const sh = aba_(nome, cols);
  const ultima = sh.getLastRow();
  if (ultima < 2) return [];
  const vals = sh.getRange(2, 1, ultima - 1, cols.length).getValues();
  const idCol = 0;
  const nomeCol = cols.indexOf('nome');
  const out = [];
  vals.forEach(function (r, i) {
    if (String(r[nomeCol]).trim() === '') return;
    if (String(r[idCol]).trim() === '') { // linha colada à mão: cria o código sozinho
      r[idCol] = novoId_();
      sh.getRange(i + 2, 1).setValue(r[idCol]);
    }
    const o = { _row: i + 2 };
    cols.forEach(function (c, j) { o[c] = r[j]; });
    out.push(o);
  });
  return out;
}

function prep_(txt, unid) {
  if (unid !== 'kg') return [];
  const v = semAcento_(txt), r = [];
  if (v.indexOf('peda') >= 0 || v.indexOf('peca') >= 0 || v.indexOf('inteiro') >= 0) r.push('Em pedaço');
  if (v.indexOf('fatia') >= 0) r.push('Fatiado');
  if (v.indexOf('ralad') >= 0) r.push('Ralado');
  return r.length ? r : ['Em pedaço'];
}
function produto_(o) {
  const unid = semAcento_(o.unidade) === 'un' || semAcento_(o.unidade).indexOf('unid') === 0 ? 'un' : 'kg';
  const promo = num_(o.promo);
  return {
    id: String(o.id), status: status_(o.status), cat: String(o.categoria || 'Outros').trim() || 'Outros',
    nome: String(o.nome).trim(), desc: String(o.descricao || '').trim(), unid: unid,
    preco: num_(o.preco), promo: promo > 0 ? promo : null, prep: prep_(o.preparos, unid),
    foto: String(o.foto || '').trim()
  };
}
function tabua_(o) {
  return {
    id: String(o.id), status: status_(o.status), nome: String(o.nome).trim(), desc: String(o.descricao || '').trim(),
    pessoas: parseInt(o.pessoas, 10) || 0,
    ocasiao: semAcento_(o.ocasiao).indexOf('princ') >= 0 ? 'principal' : 'entrada',
    itens: String(o.itens || '').split(/[\n,;]+/).map(function (s) { return s.trim(); }).filter(Boolean),
    preco: num_(o.preco), foto: String(o.foto || '').trim()
  };
}
function tabuaItem_(o) {
  const t = semAcento_(o.tipo);
  const tipo = t.indexOf('quei') === 0 ? 'queijo' : t.indexOf('embut') === 0 || t.indexOf('frio') === 0 ? 'embutido' : t.indexOf('frut') === 0 ? 'fruta' : 'complemento';
  const un = semAcento_(o.cobranca).indexOf('un') === 0 || semAcento_(o.cobranca).indexOf('por') === 0;
  return {
    id: String(o.id), status: status_(o.status) === 'oculto' ? 'oculto' : 'disponivel', tipo: tipo,
    grupo: String(o.grupo || '').trim(), nome: String(o.nome).trim(),
    cobranca: (tipo === 'fruta' || tipo === 'complemento' || un) ? 'un' : 'kg',
    preco: num_(o.preco), pesoG: num_(o.pesoG)
  };
}
function todos_() {
  return {
    produtos: tabela_('Produtos', COLS_PROD).map(produto_).filter(function (p) { return p.preco > 0; }),
    portfolio: tabela_('Portfolio', COLS_PORT).map(tabua_).filter(function (p) { return p.preco > 0; }),
    tabua: tabela_('Itens da tabua', COLS_TAB).map(tabuaItem_).filter(function (p) { return p.preco > 0; })
  };
}
/* O Google limita cada item do cache a 100 KB; o catálogo é maior, então guardamos em pedaços. */
const CACHE_TAM = 40000;
function cacheGet_() {
  const cache = CacheService.getScriptCache();
  const n = parseInt(cache.get('pub_n'), 10);
  if (!n) return null;
  const chaves = [];
  for (let i = 0; i < n; i++) chaves.push('pub_' + i);
  const partes = cache.getAll(chaves);
  let txt = '';
  for (let i = 0; i < n; i++) {
    if (partes['pub_' + i] == null) return null;
    txt += partes['pub_' + i];
  }
  return txt;
}
function cachePut_(txt) {
  const cache = CacheService.getScriptCache();
  const obj = {};
  let n = 0;
  for (let i = 0; i < txt.length; i += CACHE_TAM) obj['pub_' + (n++)] = txt.slice(i, i + CACHE_TAM);
  obj['pub_n'] = String(n);
  cache.putAll(obj, 90);
}
function cacheDel_() {
  const cache = CacheService.getScriptCache();
  const n = parseInt(cache.get('pub_n'), 10) || 0;
  const chaves = ['pub_n'];
  for (let i = 0; i < n; i++) chaves.push('pub_' + i);
  cache.removeAll(chaves);
}
function publico_() {
  const c = cacheGet_();
  if (c) return JSON.parse(c);
  const d = todos_();
  const r = {
    ok: true, ts: Date.now(),
    produtos: d.produtos.filter(function (p) { return p.status !== 'oculto'; }),
    portfolio: d.portfolio.filter(function (p) { return p.status !== 'oculto'; }),
    tabua: d.tabua.filter(function (p) { return p.status !== 'oculto'; })
  };
  try { cachePut_(JSON.stringify(r)); } catch (e) {}
  return r;
}

/* ------------------------------------------------------------------ */
/* Entrada (site do cliente e painel)                                  */
/* ------------------------------------------------------------------ */
function json_(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}
function papel_(key) {
  key = String(key || '');
  if (key && key === PIN_DONO) return 'dono';
  if (key && key === PIN_BALCAO) return 'balcao';
  return null;
}

function doGet(e) {
  try {
    return json_(publico_());
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  }
}

function doPost(e) {
  try {
    const d = JSON.parse(e.postData.contents);
    if (d.evento) return json_(lead_(d));
    const papel = papel_(d.key);
    if (!papel) return json_({ ok: false, error: 'pin' });
    if (d.action === 'admin') {
      const t = todos_();
      return json_({ ok: true, role: papel, produtos: t.produtos, portfolio: t.portfolio, tabua: t.tabua });
    }
    const lock = LockService.getScriptLock();
    lock.waitLock(15000);
    try {
      let r;
      if (d.action === 'setStatus') r = setStatus_(d);
      else if (papel !== 'dono') r = { ok: false, error: 'permissao' };
      else if (d.action === 'saveProduto') r = salvar_('Produtos', COLS_PROD, d.item, linhaProd_);
      else if (d.action === 'savePortfolio') r = salvar_('Portfolio', COLS_PORT, d.item, linhaPort_);
      else if (d.action === 'saveTabua') r = salvar_('Itens da tabua', COLS_TAB, d.item, linhaTab_);
      else if (d.action === 'deleteItem') r = excluir_(d);
      else if (d.action === 'uploadFoto') r = foto_(d);
      else if (d.action === 'resetFalta') r = reset_();
      else r = { ok: false, error: 'acao' };
      cacheDel_();
      return json_(r);
    } finally {
      lock.releaseLock();
    }
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  }
}

/* ------------------------------------------------------------------ */
/* Alterações                                                          */
/* ------------------------------------------------------------------ */
function achaLinha_(sh, id) {
  const ultima = sh.getLastRow();
  if (ultima < 2) return -1;
  const ids = sh.getRange(2, 1, ultima - 1, 1).getValues();
  for (let i = 0; i < ids.length; i++) if (String(ids[i][0]) === String(id)) return i + 2;
  return -1;
}
function setStatus_(d) {
  const tabua = d.tipo === 'tabua';
  const st = tabua ? { disponivel: 1, oculto: 1 } : { disponivel: 1, falta: 1, oculto: 1 };
  if (!st[d.status]) return { ok: false, error: 'status' };
  const portfolio = d.tipo === 'portfolio';
  const sh = tabua ? aba_('Itens da tabua', COLS_TAB) : aba_(portfolio ? 'Portfolio' : 'Produtos', portfolio ? COLS_PORT : COLS_PROD);
  const linha = achaLinha_(sh, d.id);
  if (linha < 0) return { ok: false, error: 'nao encontrado' };
  sh.getRange(linha, 2).setValue(tabua ? STATUS_TAB[d.status] : STATUS_TXT[d.status]);
  return { ok: true };
}
function excluir_(d) {
  const abas = { produto: ['Produtos', COLS_PROD], portfolio: ['Portfolio', COLS_PORT], tabua: ['Itens da tabua', COLS_TAB] };
  const a = abas[d.tipo];
  if (!a || !d.id) return { ok: false, error: 'acao' };
  const sh = aba_(a[0], a[1]);
  const linha = achaLinha_(sh, d.id);
  if (linha < 0) return { ok: false, error: 'nao encontrado' };
  sh.deleteRow(linha);
  return { ok: true };
}
function txt_(v, max) { return String(v == null ? '' : v).replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, '').trim().slice(0, max || 300); }
function linhaProd_(it, id) {
  return [id, STATUS_TXT[status_(it.status)], txt_(it.cat, 60), txt_(it.nome, 120), txt_(it.desc, 400),
    it.unid === 'un' ? 'un' : 'kg', num_(it.preco), it.promo ? num_(it.promo) : '',
    (it.prep || []).map(function (p) { return semAcento_(p).indexOf('fatia') >= 0 ? 'fatiado' : semAcento_(p).indexOf('ralad') >= 0 ? 'ralado' : 'pedaço'; }).join(', '),
    txt_(it.foto, 300)];
}
function linhaPort_(it, id) {
  return [id, STATUS_TXT[status_(it.status)], txt_(it.nome, 120), txt_(it.desc, 400), parseInt(it.pessoas, 10) || 0,
    it.ocasiao === 'principal' ? 'principal' : 'entrada', (it.itens || []).map(function (s) { return txt_(s, 80); }).join('\n'),
    num_(it.preco), txt_(it.foto, 300)];
}
function linhaTab_(it, id) {
  const tipos = { queijo: 1, embutido: 1, fruta: 1, complemento: 1 };
  const tipo = tipos[it.tipo] ? it.tipo : 'queijo';
  const cobr = (tipo === 'fruta' || tipo === 'complemento' || it.cobranca === 'un') ? 'un' : 'kg';
  return [id, STATUS_TAB[status_(it.status) === 'oculto' ? 'oculto' : 'disponivel'], tipo, txt_(it.grupo, 60), txt_(it.nome, 120),
    cobr, num_(it.preco), cobr === 'un' && (tipo === 'queijo' || tipo === 'embutido') ? num_(it.pesoG) : ''];
}
function salvar_(nome, cols, it, montaLinha) {
  if (!it || !txt_(it.nome)) return { ok: false, error: 'nome' };
  const sh = aba_(nome, cols);
  let linha = it.id ? achaLinha_(sh, it.id) : -1;
  const id = linha > 0 ? String(it.id) : novoId_();
  const valores = montaLinha(it, id);
  if (linha < 0) linha = Math.max(sh.getLastRow(), 1) + 1;
  if (linha > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 100);
  sh.getRange(linha, 1, 1, cols.length).setValues([valores]);
  return { ok: true, id: id };
}
function reset_() {
  let n = 0;
  [['Produtos', COLS_PROD], ['Portfolio', COLS_PORT]].forEach(function (par) {
    const sh = aba_(par[0], par[1]);
    const ultima = sh.getLastRow();
    if (ultima < 2) return;
    const rng = sh.getRange(2, 2, ultima - 1, 1);
    const v = rng.getValues();
    v.forEach(function (r) { if (status_(r[0]) === 'falta') { r[0] = STATUS_TXT.disponivel; n++; } });
    rng.setValues(v);
  });
  return { ok: true, n: n };
}
function foto_(d) {
  const bytes = Utilities.base64Decode(String(d.data || ''));
  if (bytes.length < 100 || bytes.length > 4 * 1024 * 1024) return { ok: false, error: 'tamanho' };
  const it = DriveApp.getFoldersByName(PASTA_FOTOS);
  const pasta = it.hasNext() ? it.next() : DriveApp.createFolder(PASTA_FOTOS);
  const nome = txt_(d.nome, 40).replace(/[^a-zA-Z0-9-]/g, '') || 'foto';
  const arq = pasta.createFile(Utilities.newBlob(bytes, 'image/jpeg', nome + '-' + Date.now() + '.jpg'));
  arq.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return { ok: true, id: arq.getId() };
}

/* ------------------------------------------------------------------ */
/* Clientes e pedidos vindos do site                                   */
/* ------------------------------------------------------------------ */
function lead_(d) {
  const quando = new Date(d.ts);
  const sim = d.receberOfertas ? 'Sim' : 'Não';
  if (d.evento === 'cadastro') {
    const sh = aba_('Clientes', COLS_CLI);
    const n = sh.getLastRow() - 1;
    const cpfs = n > 0 ? sh.getRange(2, 3, n, 1).getValues().map(function (r) { return String(r[0]); }) : [];
    const i = cpfs.indexOf(String(d.cpf));
    if (i >= 0) {
      const r = i + 2;
      sh.getRange(r, 2).setValue(d.nome);
      sh.getRange(r, 4, 1, 3).setValues([[d.celular, sim, quando]]);
    } else {
      sh.appendRow([quando, d.nome, d.cpf, d.celular, sim, quando]);
    }
  } else if (d.evento === 'pedido') {
    aba_('Pedidos', COLS_PED).appendRow([quando, d.nome, d.cpf, d.celular, d.total, d.itens, d.recebimento]);
  }
  return { ok: true };
}
